<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Instructions Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escanear Código QR de Sensor ESP32"
            android:textColor="@color/navy_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Apunta la cámara al código QR impreso en el nodo IoT SYMON para vinculación automática."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Camera Scanner Viewfinder Box -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCameraContainer"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/tech_blue"
            app:strokeWidth="2dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Viewfinder Graphic Overlay -->
                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:contentDescription="Escaner QR"
                    android:src="@drawable/bg_qr_scanner_corner" />

                <!-- Laser scan animation bar placeholder -->
                <View
                    android:id="@+id/viewScanLaser"
                    android:layout_width="200dp"
                    android:layout_height="3dp"
                    android:layout_gravity="center"
                    android:background="@color/tech_blue" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="#99000000"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Cámara Activa"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Buscando código QR de ESP32..."
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Simulated Scan Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimulateScan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/tech_blue"
            android:text="Simular Lectura de Código QR"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_qr_code"
            app:iconTint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="O ingresa el identificador manualmente"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Manual Device ID Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilManualDevice"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ID de Dispositivo (ej. ESP32-SYMON-04)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etManualDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:text="ESP32-SYMON-04" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualLink"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/navy_blue"
                android:text="Vincular"
                android:textColor="@color/white"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>