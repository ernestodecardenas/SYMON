<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material 3 DayNight NoActionBar. -->
    <style name="Base.Theme.SYMON" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Principales -->
        <item name="colorPrimary">@color/navy_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/navy_blue_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Color Secundario / Acento (Celeste Tecnológico) -->
        <item name="colorSecondary">@color/tech_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">#E0F7FA</item>
        <item name="colorOnSecondaryContainer">@color/navy_blue</item>

        <!-- Fondos y Superficies -->
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/navy_blue</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SYMON" parent="Base.Theme.SYMON" />
</resources>